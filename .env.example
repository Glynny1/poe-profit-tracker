# Local development: this is the database `npm run db:local` starts for you.
# Nothing to install, no account needed.
DATABASE_URL="postgresql://poe:poe@localhost:5433/poe_profit"

# For hosting instead, swap in a Neon connection string (https://neon.tech) and
# use the POOLED one ("-pooler" in the host):
# DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"

# Signs the session cookie. Must be at least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Anyone with this string can create an account on your instance. Make it long.
INVITE_CODE=""

# Sent to poe.ninja in the User-Agent. Their docs ask for a contact address, and
# it costs nothing to be a good citizen of a free community API.
CONTACT_EMAIL="you@example.com"
