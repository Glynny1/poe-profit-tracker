# Local development: this is the database `npm run db:local` starts for you.
# Nothing to install, no account needed.
DATABASE_URL="postgresql://poe:poe@localhost:5433/poe_profit"

# Your HOSTED database, used only by `npm run db:push:prod` to create the tables
# there. Kept separate from DATABASE_URL on purpose. If you swapped the one above
# instead, forgetting to swap it back would point your local dev server at the
# database your friends are using. Use Neon's POOLED string ("-pooler" in the host).
# PRODUCTION_DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=require"

# Signs the session cookie. Must be at least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Anyone with one of these can create an account on your instance. Make them long.
# Comma-separated, so different people can get different codes: your friends one,
# GGG another while they review your OAuth application. Deleting a code revokes
# only that way in and leaves everyone else's working.
#   INVITE_CODE="friends-xxxxxxxx,ggg-review-yyyyyyyy"
INVITE_CODE=""

# Sent to poe.ninja in the User-Agent. Their docs ask for a contact address, and
# it costs nothing to be a good citizen of a free community API.
CONTACT_EMAIL="you@example.com"
